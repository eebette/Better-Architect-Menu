<?xml version="1.0" encoding="utf-8" ?>          
<Patch>       
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[@Name="VendingMachineBase"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_Market</designationCategory>
                    </value>
                </Operation>
                <!-- added by this mod's own RimFridge patch, so it carries its own field -->
                <Operation Class="PatchOperationReplace">
                  <success>Always</success>
                  <xpath>Defs/ThingDef[defName="RimFridgeVendingMachine"]/designationCategory</xpath>
                  <value>
                    <designationCategory>Ferny_Market</designationCategory>
                  </value>
                </Operation>
</Patch>